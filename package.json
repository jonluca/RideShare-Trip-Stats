{
  "name": "rideshare-trip-stats",
  "private": true,
  "version": "11.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:safari",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "npm run zip:chrome && npm run zip:edge && npm run zip:firefox && npm run zip:safari",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "json-2-csv": "^5.5.11",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sjcl": "^1.0.34",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "web-ext": "10.5.0",
    "wxt": "0.21.3"
  },
  "packageManager": "npm@12.0.1",
  "prettier": {
    "printWidth": 140,
    "arrowParens": "always",
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "next": "16.2.12",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0"
  }
}
