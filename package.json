{
  "name": "rideshare-trip-stats",
  "private": true,
  "version": "11.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:safari",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "npm run zip:chrome && npm run zip:edge && npm run zip:firefox && npm run zip:safari",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-ext": "10.5.0",
    "wxt": "0.21.3"
  },
  "packageManager": "npm@12.0.1",
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "next": "16.2.12",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0"
  }
}
